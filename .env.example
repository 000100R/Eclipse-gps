# ==============================================================================
# SERVER-SIDE SECRETS (Never exposed to the browser client)
# ==============================================================================
# Gemini AI SDK Server Secret Key
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: Server-Side Google Maps API Key for proxying Google Places searches
GOOGLE_MAPS_API_KEY=

# ==============================================================================
# CLIENT-SIDE PUBLIC CONFIGURATION (Exposed to browser via Vite bundle)
# ==============================================================================
# Google Maps JavaScript SDK Client Key (Restricted by HTTP Referrer in Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Firebase Web Client Configuration (Protected by Firestore & Realtime DB Security Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

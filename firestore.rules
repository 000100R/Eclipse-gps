rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. MASTER GATE: Deny unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. USER PROFILES & SUBCOLLECTIONS
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth == null || request.auth.uid == userId;

      // Friend subcollection
      match /friends/{friendId} {
        allow read: if true;
        allow write: if request.auth == null || request.auth.uid == userId || request.auth.uid == friendId;
      }

      // Blocked users subcollection
      match /blockedUsers/{blockedId} {
        allow read, write: if request.auth == null || request.auth.uid == userId;
      }
    }

    // 3. ECLIPSE ID DIRECT LOOKUP INDEX
    match /eclipseIds/{normalizedId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. FRIEND REQUEST RULES
    match /friendRequests/{requestId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. FRIENDSHIP COMPATIBILITY COLLECTION
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }
  }
}

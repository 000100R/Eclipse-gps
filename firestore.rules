rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. MASTER GATE: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. USER PROFILE RULES: Publicly readable for searches, only writable by self
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. FRIEND REQUEST RULES: Highly isolated access and creation
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.senderId &&
        request.resource.data.status == 'pending';
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
    }

    // 4. FRIENDSHIP RELATION RULES: Isolated to participating members
    match /friendships/{friendshipId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.friendId
      );
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.friendId
      );
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. MASTER GATE: Deny unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. USER PROFILES & SUBCOLLECTIONS
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth == null || request.auth.uid == userId;

      // Friend subcollection
      match /friends/{friendId} {
        allow read: if true;
        allow write, delete: if request.auth == null || request.auth.uid == userId || request.auth.uid == friendId;
      }

      // Blocked users subcollection
      match /blockedUsers/{blockedId} {
        allow read: if request.auth == null || request.auth.uid == userId || request.auth.uid == blockedId;
        allow write, delete: if request.auth == null || request.auth.uid == userId;
      }
    }

    // 3. ECLIPSE ID DIRECT LOOKUP INDEX
    match /eclipseIds/{normalizedId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. FRIEND REQUEST RULES
    match /friendRequests/{requestId} {
      allow read: if true;
      // Sender can create their own request if neither user is blocked
      allow create: if (request.auth == null || request.auth.uid == request.resource.data.senderId)
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId)/blockedUsers/$(request.resource.data.senderId))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.senderId)/blockedUsers/$(request.resource.data.receiverId));
      // Only sender or receiver can update (accept/decline) or delete (cancel) request
      allow update, delete: if request.auth == null || request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId;
    }

    // 5. FRIENDSHIP COMPATIBILITY COLLECTION
    match /friendships/{friendshipId} {
      allow read: if true;
      allow write: if request.auth == null || request.auth.uid in resource.data.users || request.auth.uid in request.resource.data.users;
    }
  }
}
